# QMK Userspace Tap Dance Tests
.PHONY: help clean stats comprehensive-fixed

# Directories
TEST_DIR = keyboards/crkbd/keymaps/soycabanillas/tests
BUILD_DIR = build/tests
IMPL_DIR = keyboards/crkbd/keymaps/soycabanillas

# Common compilation flags
CXXFLAGS = -Wall -Wextra -std=c++14 -I$(TEST_DIR) -I$(IMPL_DIR) -DUNIT_TEST -DCONSOLE_ENABLE
CFLAGS = -Wall -Wextra -std=c99 -I$(TEST_DIR) -I$(IMPL_DIR) -DUNIT_TEST -DCONSOLE_ENABLE
LDFLAGS = -lgtest -lgtest_main -lpthread

# Common object files needed for all tests
COMMON_OBJECTS = $(BUILD_DIR)/pipeline_tap_dance_initializer.o $(BUILD_DIR)/pipeline_tap_dance.o $(BUILD_DIR)/pipeline_executor.o $(BUILD_DIR)/key_buffer.o $(BUILD_DIR)/platform_qmk_impl.o

# Test targets
TESTS = \
	$(BUILD_DIR)/test_basic_tap_fixed \
	$(BUILD_DIR)/test_basic_hold_fixed \
	$(BUILD_DIR)/test_multiple_tap_fixed \
	$(BUILD_DIR)/test_tap_hold_interaction_fixed \
	$(BUILD_DIR)/test_layer_switching_fixed \
	$(BUILD_DIR)/test_timeout_fixed \
	$(BUILD_DIR)/test_interruption_fixed

help:
	@echo "QMK Userspace Tap Dance Test Framework"
	@echo ""
	@echo "Targets:"
	@echo "  comprehensive-fixed  - Run all tap dance tests"
	@echo "  clean               - Clean build directory"
	@echo "  stats               - Show test statistics"
	@echo ""

clean:
	rm -rf $(BUILD_DIR)
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Pattern rule for building test binaries (without running)
$(BUILD_DIR)/test_%_fixed: $(TEST_DIR)/test_tap_dance_%_fixed.cpp $(TEST_DIR)/qmk_test_mock.cpp $(COMMON_OBJECTS) | $(BUILD_DIR)
	g++ $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

# Run all tests
comprehensive-fixed: $(TESTS)
	@echo "=== Running All Tests ==="
	@for test in $(TESTS); do \
		if [ -f $$test ]; then \
			echo "=== Running $$(basename $$test) ===" ; \
			$$test ; \
			echo "" ; \
		fi \
	done
	@echo "=== All Tests Complete ==="

# C object files
$(BUILD_DIR)/pipeline_tap_dance_initializer.o: $(IMPL_DIR)/pipeline_tap_dance_initializer.c | $(BUILD_DIR)
	gcc $(CFLAGS) -c -o $@ $<

$(BUILD_DIR)/pipeline_tap_dance.o: $(IMPL_DIR)/pipeline_tap_dance.c | $(BUILD_DIR)
	gcc $(CFLAGS) -c -o $@ $<

$(BUILD_DIR)/pipeline_executor.o: $(IMPL_DIR)/pipeline_executor.c | $(BUILD_DIR)
	gcc $(CFLAGS) -c -o $@ $<

$(BUILD_DIR)/key_buffer.o: $(IMPL_DIR)/key_buffer.c | $(BUILD_DIR)
	gcc $(CFLAGS) -c -o $@ $<

$(BUILD_DIR)/platform_qmk_impl.o: $(IMPL_DIR)/platform_qmk_impl.c | $(BUILD_DIR)
	gcc $(CFLAGS) -c -o $@ $<

# Run all tests
comprehensive-fixed: $(TESTS)
	@echo "=== Running All Tests ==="
	@for test in $(TESTS); do \
		if [ -f $$test ]; then \
			echo "=== Running $$(basename $$test) ===" ; \
			$$test ; \
			echo "" ; \
		fi \
	done
	@echo "=== All Tests Complete ==="

stats:
	@echo "QMK Userspace Tap Dance Test Suite"
	@echo ""
	@echo "Available tests:"
	@for test in $(TESTS); do \
		echo "  $$test"; \
	done
	@echo ""
	@echo "To run a specific test: make <test_name>"
	@echo "To run all tests: make comprehensive-fixed"
