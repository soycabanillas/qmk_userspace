# Enhanced Makefile for QMK Userspace Tap Dance Tests (Fixed Version)
.PHONY: help clean stats comprehensive-fixed

# Directories
TEST_DIR = keyboards/crkbd/keymaps/soycabanillas/tests
BUILD_DIR = build/tests
IMPL_DIR = keyboards/crkbd/keymaps/soycabanillas

# Implementation source files
IMPL_SOURCES_TEST = $(IMPL_DIR)/pipeline_tap_dance.c

# Common compilation flags
CXXFLAGS = -Wall -Wextra -std=c++14 -I$(TEST_DIR) -I$(IMPL_DIR) -DUNIT_TEST -DCONSOLE_ENABLE
LDFLAGS = -lgtest -lgtest_main -lpthread

# Test files (fixed versions using unified mock)
COMPREHENSIVE_FIXED_TESTS = \
	$(BUILD_DIR)/test_basic_tap_fixed \
	$(BUILD_DIR)/test_basic_hold_fixed \
	$(BUILD_DIR)/test_multiple_tap_fixed \
	$(BUILD_DIR)/test_tap_hold_interaction_fixed \
	$(BUILD_DIR)/test_layer_switching_fixed \
	$(BUILD_DIR)/test_timeout_fixed \
	$(BUILD_DIR)/test_interruption_fixed

help:
	@echo "=== QMK Userspace Tap Dance Test Framework ==="
	@echo ""
	@echo "TESTS:"
	@echo "  comprehensive-fixed  - Run all tap dance tests (using real implementation)"
	@echo ""
	@echo "UTILITIES:"
	@echo "  stats               - Show test statistics"
	@echo "  clean               - Clean build directory"
	@echo ""
	@echo "CURRENT STATUS:"
	@echo "  ✅ Comprehensive Tests: 48 tests (using real implementation with unified mock)"
	@echo ""

clean:
	rm -rf $(BUILD_DIR)
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Standalone test (baseline)
	g++ $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

# Fixed comprehensive tests using unified mock
$(BUILD_DIR)/test_basic_tap_fixed: $(TEST_DIR)/test_tap_dance_basic_tap_fixed.cpp $(TEST_DIR)/qmk_test_mock.cpp $(IMPL_DIR)/pipeline_tap_dance_initializer.c $(IMPL_SOURCES_TEST) | $(BUILD_DIR)
	g++ $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

$(BUILD_DIR)/test_basic_hold_fixed: $(TEST_DIR)/test_tap_dance_basic_hold_fixed.cpp $(TEST_DIR)/qmk_test_mock.cpp $(IMPL_DIR)/pipeline_tap_dance_initializer.c $(IMPL_SOURCES_TEST) | $(BUILD_DIR)
	g++ $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

$(BUILD_DIR)/test_multiple_tap_fixed: $(TEST_DIR)/test_tap_dance_multiple_tap_fixed.cpp $(TEST_DIR)/qmk_test_mock.cpp $(IMPL_DIR)/pipeline_tap_dance_initializer.c $(IMPL_SOURCES_TEST) | $(BUILD_DIR)
	g++ $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

$(BUILD_DIR)/test_tap_hold_interaction_fixed: $(TEST_DIR)/test_tap_dance_tap_hold_interaction_fixed.cpp $(TEST_DIR)/qmk_test_mock.cpp $(IMPL_DIR)/pipeline_tap_dance_initializer.c $(IMPL_SOURCES_TEST) | $(BUILD_DIR)
	g++ $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

$(BUILD_DIR)/test_layer_switching_fixed: $(TEST_DIR)/test_tap_dance_layer_switching_fixed.cpp $(TEST_DIR)/qmk_test_mock.cpp $(IMPL_DIR)/pipeline_tap_dance_initializer.c $(IMPL_SOURCES_TEST) | $(BUILD_DIR)
	g++ $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

$(BUILD_DIR)/test_timeout_fixed: $(TEST_DIR)/test_tap_dance_timeout_fixed.cpp $(TEST_DIR)/qmk_test_mock.cpp $(IMPL_DIR)/pipeline_tap_dance_initializer.c $(IMPL_SOURCES_TEST) | $(BUILD_DIR)
	g++ $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

$(BUILD_DIR)/test_interruption_fixed: $(TEST_DIR)/test_tap_dance_interruption_fixed.cpp $(TEST_DIR)/qmk_test_mock.cpp $(IMPL_DIR)/pipeline_tap_dance_initializer.c $(IMPL_SOURCES_TEST) | $(BUILD_DIR)
	g++ $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

# Test targets
comprehensive-fixed: $(COMPREHENSIVE_FIXED_TESTS)
	@echo "=== Running All Tap Dance Tests (48 tests) ==="
	@echo "--- Basic Tap Tests (6 tests) ---"
	./$(BUILD_DIR)/test_basic_tap_fixed
	@echo ""
	@echo "--- Basic Hold Tests (7 tests) ---"
	./$(BUILD_DIR)/test_basic_hold_fixed
	@echo ""
	@echo "--- Multiple Tap Tests (7 tests) ---"
	./$(BUILD_DIR)/test_multiple_tap_fixed
	@echo ""
	@echo "--- Tap-Hold Interaction Tests (6 tests) ---"
	./$(BUILD_DIR)/test_tap_hold_interaction_fixed
	@echo ""
	@echo "--- Layer Switching Tests (8 tests) ---"
	./$(BUILD_DIR)/test_layer_switching_fixed
	@echo ""
	@echo "--- Timeout Tests (7 tests) ---"
	./$(BUILD_DIR)/test_timeout_fixed
	@echo ""
	@echo "--- Interruption Tests (7 tests) ---"
	./$(BUILD_DIR)/test_interruption_fixed
	@echo ""
	@echo "=== Fixed Comprehensive Tests Complete ==="

	@echo ""
	@echo "=== All Fixed Tests Summary ==="
	@echo "✅ Standalone: 9 tests"
	@echo "✅ Basic Tap: 6 tests"
	@echo "✅ Basic Hold: 7 tests"
	@echo "✅ Multiple Tap: 7 tests"
	@echo "✅ Tap-Hold Interaction: 6 tests"
	@echo "✅ Layer Switching: 8 tests"
	@echo "✅ Timeout: 7 tests"
	@echo "✅ Interruption: 7 tests"
	@echo "Total: 48 tests (using real implementation)"

