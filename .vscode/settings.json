{
    "files.associations": {
        "*.c": "c",
        "*.h": "c",
        "*.cpp": "cpp",
        "*.hpp": "cpp"
    },
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--background-index",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--function-arg-placeholders=false"
    ],
    "clangd.detectExtensionConflicts": true,
    "clangd.checkUpdates": false,
    "files.exclude": {
        "**/build/": false,
        "**/.build/": true,
        "**/compile_commands.json": false
    },
    "search.exclude": {
        "**/build/": false,
        "**/.build/": true
    }
}
